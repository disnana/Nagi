# 未リリースのsource checkout用。公開Nagi 0.2.1では位置引数を使用する。
# 名前が単位と用途を示すため、12個の上限値を読み違えにくい。
import std.http.server as http

def response_budget() -> Result[http.ResponseLimits, Error]:
    return http.response_limits(
        body_bytes=1048576,
        user_header_bytes=8192,
        user_header_count=32,
        managed_header_bytes=8192,
        managed_header_count=32,
        serialization_writes=65536,
        live_responses=64,
        retained_bytes=83886080,
        fallback_responses=1024,
        fallback_retained_bytes=285212672,
        fallback_managed_header_bytes=8192,
        fallback_managed_header_count=32
    )

def main() -> Result[unit, Error]:
    budget = try response_budget()
    print("response limits are valid")
    return ok(print("ready"))
