import std.db.sqlite as sqlite
import std.result as result
# HTTP body -> CreateUser -> SQL bind -> User -> JSON using explicit routes.
import std.http.server as http

class User:
    id: i64
    name: str
    age: i32

class CreateUser:
    name: str
    age: i32

class State:
    db: sqlite.Pool

def path_i64(request: view[http.Request], prefix: view[str]) -> Result[i64, Error]:
    path = request.path
    if len(path) <= len(prefix):
        return error("path value is missing")
    value = try slice(path, len(prefix), len(path))
    return parse_i64(value)

def query_user(request: view[http.Request]) -> Result[User, Error]:
    match request.query:
        case Some(query):
            if len(query) < 12 or try slice(query, 0, 6) != "limit=":
                return error("query must contain limit and name")
            separator = -1
            index = 6
            while separator < 0 and index + 6 <= len(query):
                part = try slice(query, index, index + 6)
                if part == "&name=":
                    separator = index
                else:
                    index += 1
            if separator < 0:
                return error("query must contain limit and name")
            limit = try parse_i64(try slice(query, 6, separator))
            name = try slice(query, separator + 6, len(query))
            if len(name) == 0:
                return error("name is required")
            return ok(User(id=limit, name=copy(name), age=18))
        case None:
            return error("query must contain limit and name")

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return http.text(http.response_context(view(request)), http.Status.OK, "ok")

async def small(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    user = User(id=1, name="alice", age=18)
    return http.json[User](http.response_context(view(request)), http.Status.OK, user)

async def query_params(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    user = try query_user(view(request))
    return http.json[User](http.response_context(view(request)), http.Status.OK, user)

async def get_user(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try path_i64(view(request), view("/users/"))
    match await storage_get_user(view(state.db), id):
        case Ok(found):
            match found:
                case Some(user):
                    return http.json[User](http.response_context(view(request)), http.Status.OK, user)
                case None:
                    return http.empty(http.response_context(view(request)), http.Status.NOT_FOUND)
        case Err(problem):
            return fail(problem)

async def list_users(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    users = try await storage_list_users(view(state.db))
    return http.json[List[User]](http.response_context(view(request)), http.Status.OK, users)

async def create_user(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    input = try json_decode[CreateUser](request.body)
    user = try await storage_create_user(view(state.db), input.name, input.age)
    return http.json[User](http.response_context(view(request)), http.Status.OK, user)

async def update_user(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try path_i64(view(request), view("/users/"))
    input = try json_decode[CreateUser](request.body)
    user = try await storage_update_user(view(state.db), id, input.name, input.age)
    return http.json[User](http.response_context(view(request)), http.Status.OK, user)

async def delete_user(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try path_i64(view(request), view("/users/"))
    deleted = try await storage_delete_user(view(state.db), id)
    return http.json[i64](http.response_context(view(request)), http.Status.OK, deleted)

async def echo(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    input = try json_decode[CreateUser](request.body)
    return http.json[CreateUser](http.response_context(view(request)), http.Status.OK, input)

async def wait_ms(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    duration = try path_i64(view(request), view("/wait/"))
    await sleep(duration)
    return http.json[i64](http.response_context(view(request)), http.Status.OK, duration)

async def bounded_bytes(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    source = try http.text(http.response_context(view(request)), http.Status.OK, "chunk:0\nchunk:1\nchunk:2\nchunk:3\nchunk:4\n")
    return http.bytes(http.response_context(view(request)), http.Status.OK, source.body)

async def main() -> Result[unit, Error]:
    path = env("NAGI_DB", ":memory:")
    db = try await open_database(view(path))
    try await bootstrap_users(view(db))
    app = http.app_default[State](State(db=db))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    route_policy_1 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/health", route_policy_1)
    app = try http.route(app, http.Method.GET, "/small", http.public_policy[State](), small)
    route_policy_2 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/small", route_policy_2)
    app = try http.route(app, http.Method.GET, "/query", http.public_policy[State](), query_params)
    route_policy_3 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/query", route_policy_3)
    app = try http.route(app, http.Method.GET, "/users/{id}", http.public_policy[State](), get_user)
    route_policy_4 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/users/{id}", route_policy_4)
    app = try http.route(app, http.Method.GET, "/users", http.public_policy[State](), list_users)
    route_policy_5 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/users", route_policy_5)
    app = try http.route(app, http.Method.POST, "/users", http.public_policy[State](), create_user)
    route_policy_6 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.POST, "/users", route_policy_6)
    app = try http.route(app, http.Method.PUT, "/users/{id}", http.public_policy[State](), update_user)
    route_policy_7 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.PUT, "/users/{id}", route_policy_7)
    app = try http.route(app, http.Method.DELETE, "/users/{id}", http.public_policy[State](), delete_user)
    route_policy_8 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.DELETE, "/users/{id}", route_policy_8)
    app = try http.route(app, http.Method.POST, "/echo", http.public_policy[State](), echo)
    route_policy_9 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.POST, "/echo", route_policy_9)
    app = try http.route(app, http.Method.GET, "/wait/{id}", http.public_policy[State](), wait_ms)
    route_policy_10 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/wait/{id}", route_policy_10)
    app = try http.route(app, http.Method.GET, "/stream", http.public_policy[State](), bounded_bytes)
    route_policy_11 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/stream", route_policy_11)
    limits = try http.options(1048576, 10000, 2000, 10000)
    limits = try http.capacity(limits, 1024, 256)
    port = 8080
    limits = try http.authority(limits, "https://localhost", ["localhost:8080", "127.0.0.1:8080"], 2, 256)
    # Explicit illustrative profile only; not a sizing/SLA recommendation; native validation is pending.
    response_budget = try http.response_limits(
        1048576, 8192, 32, 8192, 32, 65536, 64, 83886080, 1024, 285212672, 8192, 32
    )
    limits = try http.with_response_limits(limits, response_budget)
    rate_budget = try http.rate_limits(64, 64, 4096, 4194304, 65536)
    limits = try http.with_rate_limits(limits, rate_budget)
    return await http.serve(app, port, limits)

# This HTTP-facing projection preserves the primary Error. The SQLite Failure
# (outcome, cleanup and retired metadata) stays observable in database APIs.
def sqlite_error(problem: sqlite.Failure) -> Error:
    match sqlite.copy_primary_error(view(problem)):
        case Some(cause):
            return cause
        case None:
            fallback: Result[Error, Error] = internal_error("SQLite operation failed")
            match fallback:
                case Ok(cause):
                    return cause
                case Err(cause):
                    return cause

async def open_database(path: view[str]) -> Result[sqlite.Pool, Error]:
    # Explicit example limits: one connection, two queued Tx commands,
    # 1000 ms acquisition and no native busy wait.
    config = try sqlite.options(1, 2, 1000, 0)
    return result.map_error(await sqlite.open(path, config), sqlite_error)

async def storage_get_user(pool: view[sqlite.Pool], value0: i64) -> Result[User?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[User](tx, sqlite.literal("SELECT id, name, age FROM users WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_list_users(pool: view[sqlite.Pool]) -> Result[List[User], Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.all[User](tx, sqlite.literal("SELECT id, name, age FROM users ORDER BY id"), sqlite.parameters())
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_create_user(pool: view[sqlite.Pool], value0: str, value1: i32) -> Result[User, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    try result.map_error(await sqlite.exec(tx, sqlite.literal("INSERT INTO users(name, age) VALUES (?, ?)"), sqlite.bind_i64(sqlite.bind_text(sqlite.parameters(), value0), i64(value1))), sqlite_error)
    found = try result.map_error(await sqlite.query[User](tx, sqlite.literal("SELECT id, name, age FROM users WHERE id = last_insert_rowid()"), sqlite.parameters()), sqlite_error)
    match found:
        case Some(value):
            try result.map_error(await sqlite.commit(tx), sqlite_error)
            return ok(value)
        case None:
            try result.map_error(await sqlite.rollback(tx), sqlite_error)
            return not_found("database row not found")

async def storage_update_user(pool: view[sqlite.Pool], value0: i64, value1: str, value2: i32) -> Result[User, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    try result.map_error(await sqlite.exec(tx, sqlite.literal("UPDATE users SET name = ?, age = ? WHERE id = ?"), sqlite.bind_i64(sqlite.bind_i64(sqlite.bind_text(sqlite.parameters(), value1), i64(value2)), value0)), sqlite_error)
    found = try result.map_error(await sqlite.query[User](tx, sqlite.literal("SELECT id, name, age FROM users WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0)), sqlite_error)
    match found:
        case Some(value):
            try result.map_error(await sqlite.commit(tx), sqlite_error)
            return ok(value)
        case None:
            try result.map_error(await sqlite.rollback(tx), sqlite_error)
            return not_found("database row not found")

async def storage_delete_user(pool: view[sqlite.Pool], value0: i64) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("DELETE FROM users WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

# Trusted startup management: fixed reviewed SQL, called only before HTTP registration.
# No request SQL string or dynamic Query factory is exposed.
async def bootstrap_users(pool: view[sqlite.Pool]) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER NOT NULL)"), sqlite.parameters())
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)
