{
  "name": "nagi-documentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prepare:content": "node scripts/prepare-content.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:teaching": "node scripts/verify-teaching-evidence.mjs",
    "build": "npm run prepare:content && npm run verify:content && npm run verify:teaching && next build --webpack && node scripts/generate-discovery.mjs",
    "typecheck": "node scripts/clean-next-types.mjs && npm run prepare:content && next typegen && tsc --noEmit",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:links": "node scripts/check-links.mjs",
    "test:browser": "playwright test",
    "test": "npm run typecheck && npm run build && npm run verify:static && npm run verify:links && npm run test:browser"
  },
  "dependencies": {
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.9",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
