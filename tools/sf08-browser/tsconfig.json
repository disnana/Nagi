{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}
