@@ -16,0 +19,22 @@ struct SourceFile {
+
+/// Request-local presentation data from the same text that produced AST spans.
+pub(crate) struct SourceFileView<'a> {
+    pub path: &'a Path,
+    pub text: &'a str,
+    pub start: usize,
+    tokens: &'a [crate::lexer::Token],
+    high: bool,
+}
+impl<'a> SourceFileView<'a> {
+    pub(crate) fn editor_tokens(&self) -> Result<Cow<'a, [crate::lexer::Token]>, String> {
+        let high = self.path.extension().is_none_or(|x| x != "low");
+        if self.high == high {
+            Ok(Cow::Borrowed(self.tokens))
+        } else {
+            // Public source::load accepts an explicit mode, and native files
+            // need not end in .low. Preserve presentation consumers' previous
+            // extension-based lexing for those unusual inputs.
+            crate::lexer::lex(self.text, high).map(Cow::Owned)
+        }
+    }
+}
@@ -191,0 +216,9 @@ impl Sources {
+    pub(crate) fn file_views(&self) -> impl Iterator<Item = SourceFileView<'_>> {
+        self.files.iter().map(|file| SourceFileView {
+            path: &file.path,
+            text: &file.source,
+            start: file.start,
+            tokens: &file.tokens,
+            high: file.high,
+        })
+    }
@@ -519,0 +553 @@ pub fn load_with_overlays(
+            high,
@@ -734,0 +769,33 @@ mod disk_budget_tests {
+
+#[cfg(test)]
+mod editor_token_tests {
+    use super::*;
+
+    #[test]
+    fn presentation_tokens_borrow_only_the_matching_parse_mode() {
+        let text = "fn main() {\n    let value = 1;\n}\n";
+        let (_, tokens) = crate::parser::parse_with_tokens(text, false).unwrap();
+        let low = SourceFileView {
+            path: Path::new("main.low"),
+            text,
+            start: 23,
+            tokens: &tokens,
+            high: false,
+        };
+        let borrowed = low.editor_tokens().unwrap();
+        assert!(matches!(borrowed, Cow::Borrowed(_)));
+        assert!(std::ptr::eq(borrowed.as_ptr(), tokens.as_ptr()));
+        let high_filename = SourceFileView {
+            path: Path::new("native.nagi"),
+            ..low
+        };
+        let owned = high_filename.editor_tokens().unwrap();
+        assert!(matches!(owned, Cow::Owned(_)));
+        assert!(owned
+            .iter()
+            .any(|token| token.kind == crate::lexer::K::Indent));
+        assert!(!tokens
+            .iter()
+            .any(|token| token.kind == crate::lexer::K::Indent));
+    }
+}
