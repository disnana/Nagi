@@ -82,0 +83,15 @@ fn reference_at<'a>(
+#[test]
+fn explicit_low_load_with_high_filename_preserves_editor_lex_failure() {
+    let f = Fixture::new();
+    // The public loader accepts an explicit syntax mode. Presentation indexing
+    // historically lexes by filename; reusing Low tokens must not hide its
+    // existing High-indentation error on this unusual input.
+    f.write(
+        "main.nagi",
+        "fn main() {\n    let fresh = 1;\n  print(fresh);\n}\n",
+    );
+    let loaded = source::load(&f.0.join("main.nagi"), false).unwrap();
+    let error = symbols::index(&loaded, &[&loaded.program]).unwrap_err();
+    assert_eq!(error, "line 3: 字下げが外側のブロックと一致しません");
+}
