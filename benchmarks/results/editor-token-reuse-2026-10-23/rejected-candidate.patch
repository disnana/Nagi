+#[cfg(test)]
+mod editor_token_tests {
+    use super::*;
+
+    #[test]
+    fn presentation_tokens_borrow_only_the_matching_parse_mode() {
+        let text = "fn main() {\n    let value = 1;\n}\n";
+        let (_, tokens) = crate::parser::parse_with_tokens(text, false).unwrap();
+        let low = SourceFileView {
+            path: Path::new("main.low"),
+            text,
+            start: 23,
+            tokens: &tokens,
+            high: false,
+        };
+        let borrowed = low.editor_tokens().unwrap();
+        assert!(matches!(borrowed, Cow::Borrowed(_)));
+        assert!(std::ptr::eq(borrowed.as_ptr(), tokens.as_ptr()));
+        let high_filename = SourceFileView {
+            path: Path::new("native.nagi"),
+            ..low
+        };
+        let owned = high_filename.editor_tokens().unwrap();
+        assert!(matches!(owned, Cow::Owned(_)));
+        assert!(owned
+            .iter()
+            .any(|token| token.kind == crate::lexer::K::Indent));
+        assert!(!tokens
+            .iter()
+            .any(|token| token.kind == crate::lexer::K::Indent));
+    }
+}
