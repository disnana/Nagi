+/// Request-local presentation data from the same text that produced AST spans.
+pub(crate) struct SourceFileView<'a> {
+    pub path: &'a Path,
+    pub text: &'a str,
+    pub start: usize,
+    tokens: &'a [crate::lexer::Token],
+    high: bool,
+}
+impl<'a> SourceFileView<'a> {
+    pub(crate) fn editor_tokens(&self) -> Result<Cow<'a, [crate::lexer::Token]>, String> {
+        let high = self.path.extension().is_none_or(|x| x != "low");
+        if self.high == high {
+            Ok(Cow::Borrowed(self.tokens))
+        } else {
+            // Public source::load accepts an explicit mode, and native files
+            // need not end in .low. Preserve presentation consumers' previous
+            // extension-based lexing for those unusual inputs.
+            crate::lexer::lex(self.text, high).map(Cow::Owned)
+        }
+    }
+}
