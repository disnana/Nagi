from std.task import TaskFailure

def take(result: Result[i64, TaskFailure]) -> bool:
    print("receipt-executed")
    match result:
        case Ok(value):
            return True
        case Err(failure):
            return False

async def work() -> i64:
    return 42

async def main() -> Result[unit, Error]:
    async with scope:
        task = spawn work()
        value = False and take(await task)
        print(value)
    return ok(print("scope-ok"))
