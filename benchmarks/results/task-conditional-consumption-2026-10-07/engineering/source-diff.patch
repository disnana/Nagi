+    fn conditional_expr(&mut self, e: &mut Expr, expected: Option<&Type>) -> Result<Type, String> {
+        // Check the evaluated path, including its typed/ownership facts, then
+        // join the skipped path. A conditional consume makes a value possibly
+        // moved, but cannot discharge a Task obligation on every normal path.
+        // Like statement branches, this remains conservative for literal
+        // conditions; expression checking does not fold runtime control flow.
+        let skipped = self.vars.clone();
+        let ty = self.expr(e, expected)?;
+        self.merge_moves(skipped);
+        Ok(ty)
+    }
