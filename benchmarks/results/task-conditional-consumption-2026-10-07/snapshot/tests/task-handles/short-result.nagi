from std.task import TaskFailure
def take(result: Result[Result[i64, i64], TaskFailure]) -> bool:
    return True
async def work() -> Result[i64, i64]:
    return ok(7)
async def exercise(flag: bool) -> Result[unit, Error]:
    async with scope:
        task = spawn work() # primary
        value = flag and take(await task)
        print(value)
    return ok(print(0))
