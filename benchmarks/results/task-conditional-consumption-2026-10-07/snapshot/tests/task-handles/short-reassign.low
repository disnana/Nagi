from std.task import TaskFailure;
fn take(result: Result[i64,TaskFailure]) -> bool {
    match result { case Ok(value) { return True; } case Err(failure) { return False; } }
}
async fn work() -> i64 { return 7; }
async fn exercise(flag: bool) -> Result[unit,Error] {
    scope {
        let task = spawn work();
        let value = flag and take(await task);
        task = spawn work(); # primary
        print(value);
    }
    return ok(print(0));
}
