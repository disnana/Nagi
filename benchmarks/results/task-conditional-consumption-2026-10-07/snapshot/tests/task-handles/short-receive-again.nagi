from std.task import TaskFailure

def take(result: Result[i64, TaskFailure]) -> bool:
    match result:
        case Ok(value):
            return True
        case Err(failure):
            return False

async def work() -> i64:
    return 7

async def exercise(flag: bool) -> Result[unit, Error]:
    async with scope:
        task = spawn work()
        value = flag or take(await task)
        received = await task # primary
        print(value)
    return ok(print(0))
