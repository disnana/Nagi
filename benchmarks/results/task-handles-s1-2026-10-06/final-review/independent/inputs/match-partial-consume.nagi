from std.task import discard
async def work() -> i64:
    return 7
async def main() -> Result[unit, Error]:
    async with scope:
        task = spawn work()  # primary
        choice: Option[i64] = some(1)
        match choice:
            case Some(number):
                discard(task)
            case None:
                print(0)
    return ok(print(0))
