from std.task import discard;
async fn work() -> i64 { return 7; }
async fn exercise(flag: bool) -> Result[unit, Error] {
    let choice: Option[i64] = None;
    if flag { choice = some(1); }
    scope {
        let task = spawn work();
        match choice {
            case Some(number) {
                let received = await task;
                match received { case Ok(value) { assert_true(value == 7); } case Err(failure) { assert_true(False); } }
            }
            case None { discard(task); }
        }
        let number = 0;
        while number < 2 {
            task = spawn work();
            let received = await task;
            match received { case Ok(value) { assert_true(value == 7); } case Err(failure) { assert_true(False); } }
            number = number + 1;
        }
    }
    return ok(print(0));
}
