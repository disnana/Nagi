async fn work() -> i64 { return 7; }
async fn exercise(flag: bool) -> Result[unit, Error] {
    scope {
        let task = spawn work();
        if flag { let received = await task; task = spawn work(); }
        else { let received = await task; task = spawn work(); }
        let final = await task;
    }
    return ok(print(0));
}
