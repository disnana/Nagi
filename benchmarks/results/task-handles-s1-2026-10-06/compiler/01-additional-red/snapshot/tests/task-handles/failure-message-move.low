from std.task import message;
from std.ownership import move;
async fn work() -> i64 { return 7; }
async fn main() -> Result[unit, Error] {
    scope {
        let task = spawn work();
        let received = await task;
        match received {
            case Ok(value) { print(value); }
            case Err(failure) {
                let text = message(failure);
                let moved = move(failure); # primary
                print(text);
            }
        }
    }
    return ok(print(0));
}
