import std.db.sqlite as sqlite
import std.result as result
# Small inventory API: explicit HTTP routes -> typed class -> SQLite -> JSON.
import std.http.server as http

class Item:
    id: i64
    name: str
    quantity: i32

class SaveItem:
    name: str
    quantity: i32

class InventorySummary:
    item_count: i64
    total_quantity: i64
    out_of_stock: i64

class DeleteResult:
    id: i64
    deleted: bool

class State:
    db: sqlite.Pool

def validate_item(name: view[str], quantity: i32) -> Result[bool, Error]:
    if len(name) == 0 or len(name) > 120:
        return error("name must be between 1 and 120 UTF-8 bytes")
    if quantity < 0 or quantity > 1000000:
        return error("quantity must be between 0 and 1000000")
    return ok(true)

def validate_id(id: i64) -> Result[bool, Error]:
    if id <= 0:
        return error("id must be positive")
    return ok(true)

def item_id(request: view[http.Request]) -> Result[i64, Error]:
    if len(request.path) <= 7:
        return error("item id is missing")
    return parse_i64(try slice(request.path, 7, len(request.path)))

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return ok(http.text(http.Status.OK, "ok"))

async def list_items(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    rows = try await storage_list_items(view(state.db))
    return http.json[List[Item]](http.Status.OK, rows)

async def get_item(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try item_id(view(request))
    try validate_id(id)
    match await storage_get_item(view(state.db), id):
        case Ok(found):
            match found:
                case Some(item):
                    return http.json[Item](http.Status.OK, item)
                case None:
                    return ok(http.empty(http.Status.NOT_FOUND))
        case Err(problem):
            return fail(problem)

async def create_item(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    input = try json_decode[SaveItem](request.body)
    try validate_item(view(input.name), input.quantity)
    item = try await storage_create_item(view(state.db), input.name, input.quantity)
    return http.json[Item](http.Status.OK, item)

async def update_item(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try item_id(view(request))
    input = try json_decode[SaveItem](request.body)
    try validate_id(id)
    try validate_item(view(input.name), input.quantity)
    item = try await storage_update_item(view(state.db), id, input.name, input.quantity)
    return http.json[Item](http.Status.OK, item)

async def delete_item(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try item_id(view(request))
    try validate_id(id)
    affected = try await storage_delete_item(view(state.db), id)
    return http.json[DeleteResult](http.Status.OK, DeleteResult(id=id, deleted=affected > 0))

async def inventory_summary(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    match await storage_inventory_summary(view(state.db), 0):
        case Ok(found):
            match found:
                case Some(summary):
                    return http.json[InventorySummary](http.Status.OK, summary)
                case None:
                    return ok(http.empty(http.Status.NOT_FOUND))
        case Err(problem):
            return fail(problem)

async def main() -> Result[unit, Error]:
    path = env("NAGI_DB", ":memory:")
    port = try parse_i64(env("NAGI_PORT", "8090"))
    if port < 1 or port > 65535:
        return error("NAGI_PORT must be between 1 and 65535")
    db = try await open_database(view(path))
    try await bootstrap_inventory(view(db))
    print("Inventory API ready on 127.0.0.1")
    print(port)
    app = http.app_default[State](State(db=db))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    app = try http.route(app, http.Method.GET, "/items", http.public_policy[State](), list_items)
    app = try http.route(app, http.Method.GET, "/items/{id}", http.public_policy[State](), get_item)
    app = try http.route(app, http.Method.POST, "/items", http.public_policy[State](), create_item)
    app = try http.route(app, http.Method.PUT, "/items/{id}", http.public_policy[State](), update_item)
    app = try http.route(app, http.Method.DELETE, "/items/{id}", http.public_policy[State](), delete_item)
    app = try http.route(app, http.Method.GET, "/inventory/summary", http.public_policy[State](), inventory_summary)
    return await http.serve(app, port, http.default_options())

# This HTTP-facing projection preserves the primary Error. The SQLite Failure
# (outcome, cleanup and retired metadata) stays observable in database APIs.
def sqlite_error(problem: sqlite.Failure) -> Error:
    match sqlite.copy_primary_error(view(problem)):
        case Some(cause):
            return cause
        case None:
            fallback: Result[Error, Error] = internal_error("SQLite operation failed")
            match fallback:
                case Ok(cause):
                    return cause
                case Err(cause):
                    return cause

async def open_database(path: view[str]) -> Result[sqlite.Pool, Error]:
    # Explicit example limits: one connection, two queued Tx commands,
    # 1000 ms acquisition and no native busy wait.
    config = try sqlite.options(1, 2, 1000, 0)
    return result.map_error(await sqlite.open(path, config), sqlite_error)

async def storage_list_items(pool: view[sqlite.Pool]) -> Result[List[Item], Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.all[Item](tx, sqlite.literal("SELECT id, name, quantity FROM sample_inventory_items ORDER BY id DESC LIMIT 100"), sqlite.parameters())
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_get_item(pool: view[sqlite.Pool], value0: i64) -> Result[Item?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[Item](tx, sqlite.literal("SELECT id, name, quantity FROM sample_inventory_items WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_create_item(pool: view[sqlite.Pool], value0: str, value1: i32) -> Result[Item, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    try result.map_error(await sqlite.exec(tx, sqlite.literal("INSERT INTO sample_inventory_items(name, quantity) VALUES (?, ?)"), sqlite.bind_i64(sqlite.bind_text(sqlite.parameters(), value0), i64(value1))), sqlite_error)
    found = try result.map_error(await sqlite.query[Item](tx, sqlite.literal("SELECT id, name, quantity FROM sample_inventory_items WHERE id = last_insert_rowid()"), sqlite.parameters()), sqlite_error)
    match found:
        case Some(value):
            try result.map_error(await sqlite.commit(tx), sqlite_error)
            return ok(value)
        case None:
            try result.map_error(await sqlite.rollback(tx), sqlite_error)
            return not_found("database row not found")

async def storage_update_item(pool: view[sqlite.Pool], value0: i64, value1: str, value2: i32) -> Result[Item, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    try result.map_error(await sqlite.exec(tx, sqlite.literal("UPDATE sample_inventory_items SET name = ?, quantity = ? WHERE id = ?"), sqlite.bind_i64(sqlite.bind_i64(sqlite.bind_text(sqlite.parameters(), value1), i64(value2)), value0)), sqlite_error)
    found = try result.map_error(await sqlite.query[Item](tx, sqlite.literal("SELECT id, name, quantity FROM sample_inventory_items WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0)), sqlite_error)
    match found:
        case Some(value):
            try result.map_error(await sqlite.commit(tx), sqlite_error)
            return ok(value)
        case None:
            try result.map_error(await sqlite.rollback(tx), sqlite_error)
            return not_found("database row not found")

async def storage_delete_item(pool: view[sqlite.Pool], value0: i64) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("DELETE FROM sample_inventory_items WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_inventory_summary(pool: view[sqlite.Pool], value0: i64) -> Result[InventorySummary?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[InventorySummary](tx, sqlite.literal("SELECT COUNT(*) AS item_count, COALESCE(SUM(quantity), 0) AS total_quantity, COALESCE(SUM(CASE WHEN quantity = 0 THEN 1 ELSE 0 END), 0) AS out_of_stock FROM sample_inventory_items WHERE id > ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

# Trusted startup management: fixed reviewed SQL, called only before HTTP registration.
# No request SQL string or dynamic Query factory is exposed.
async def bootstrap_inventory(pool: view[sqlite.Pool]) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("CREATE TABLE IF NOT EXISTS sample_inventory_items(id INTEGER PRIMARY KEY, name TEXT NOT NULL CHECK(length(CAST(name AS BLOB)) BETWEEN 1 AND 120), quantity INTEGER NOT NULL CHECK(quantity BETWEEN 0 AND 1000000))"), sqlite.parameters())
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)
