import std.db.sqlite as sqlite
import std.result as result
import "models.nagi"
import std.http.server as http

class State:
    db: sqlite.Pool

class ErrorBody:
    error: str

async def read_optional(state: shared[State]) -> Result[Item?, Error]:
    return await storage_read_optional(view(state.db), 1)

async def read_item(state: shared[State], id: i64) -> Result[Item?, Error]:
    return await storage_read_item(view(state.db), id)

def response_error(status: http.Status, message: str) -> http.Response:
    match http.json[ErrorBody](status, ErrorBody(error=message)):
        case Ok(response):
            return response
        case Err(_):
            return http.empty(http.Status.INTERNAL_SERVER_ERROR)

def api_error(problem: Error) -> http.Response:
    kind = error_kind(problem)
    if kind == "invalid":
        return response_error(http.Status.BAD_REQUEST, error_message(problem))
    if kind == "not_found":
        return response_error(http.Status.NOT_FOUND, error_message(problem))
    return response_error(http.Status.INTERNAL_SERVER_ERROR, "internal error")

def query_value(request: view[http.Request]) -> Result[str, Error]:
    match request.query:
        case Some(query):
            if len(query) < 7 or try slice(query, 0, 6) != "value=":
                return error("value must be an integer")
            return ok(copy(try slice(query, 6, len(query))))
        case None:
            return error("value must be an integer")

def item_id(request: view[http.Request]) -> Result[i64, Error]:
    if len(request.path) <= 11:
        return error("id must be positive")
    return parse_i64(try slice(request.path, 11, len(request.path)))

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return ok(http.text(http.Status.OK, "ok"))

async def double(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    value = try query_value(view(request))
    match parse_i64(view(value)):
        case Ok(number):
            if number < 0 or number > 1000000:
                return error("value must be between 0 and 1000000")
            return http.json[Number](http.Status.OK, Number(value=number * 2))
        case Err(_):
            return error("value must be an integer")

async def get_item(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try item_id(view(request))
    if id < 1:
        return error("id must be positive")
    if id > 1000000:
        return not_found("item is outside the sample range")
    match await read_item(state, id):
        case Ok(item):
            match item:
                case Some(value):
                    return http.json[Item](http.Status.OK, value)
                case None:
                    return not_found("not found")
        case Err(problem):
            return fail(problem)

async def fallback(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    match await read_optional(state):
        case Ok(item):
            match item:
                case Some(value):
                    return http.json[Item](http.Status.OK, value)
                case None:
                    return not_found("not found")
        case Err(problem):
            print(error_kind(problem))
            return http.json[Item](http.Status.OK, Item(id=0, name="cached item"))

async def database_error(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    match await read_optional(state):
        case Ok(item):
            match item:
                case Some(value):
                    return http.json[Item](http.Status.OK, value)
                case None:
                    return not_found("not found")
        case Err(problem):
            print(error_kind(problem))
            return fail(problem)

async def internal_failure(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return internal_error("sample internal failure")

async def main() -> Result[unit, Error]:
    port = try parse_i64(env("NAGI_PORT", "8097"))
    if port < 1 or port > 65535:
        return error("NAGI_PORT must be between 1 and 65535")
    db = try await open_database(view(":memory:"))
    try await bootstrap_items(view(db))
    try await seed_items(view(db))
    app = http.app[State, Error](State(db=db), api_error)
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    app = try http.route(app, http.Method.GET, "/api/double", http.public_policy[State](), double)
    app = try http.route(app, http.Method.GET, "/api/items/{id}", http.public_policy[State](), get_item)
    app = try http.route(app, http.Method.GET, "/api/fallback", http.public_policy[State](), fallback)
    app = try http.route(app, http.Method.GET, "/api/db-error", http.public_policy[State](), database_error)
    app = try http.route(app, http.Method.GET, "/api/internal-error", http.public_policy[State](), internal_failure)
    return await http.serve(app, port, http.default_options())

# This HTTP-facing projection preserves the primary Error. The SQLite Failure
# (outcome, cleanup and retired metadata) stays observable in database APIs.
def sqlite_error(problem: sqlite.Failure) -> Error:
    match sqlite.copy_primary_error(view(problem)):
        case Some(cause):
            return cause
        case None:
            fallback: Result[Error, Error] = internal_error("SQLite operation failed")
            match fallback:
                case Ok(cause):
                    return cause
                case Err(cause):
                    return cause

async def open_database(path: view[str]) -> Result[sqlite.Pool, Error]:
    # Explicit example limits: one connection, two queued Tx commands,
    # 1000 ms acquisition and no native busy wait.
    config = try sqlite.options(1, 2, 1000, 0)
    return result.map_error(await sqlite.open(path, config), sqlite_error)

async def storage_read_optional(pool: view[sqlite.Pool], value0: i64) -> Result[Item?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[Item](tx, sqlite.literal("SELECT id, name FROM optional_items WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_read_item(pool: view[sqlite.Pool], value0: i64) -> Result[Item?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[Item](tx, sqlite.literal("SELECT id, name FROM sample_items WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

# Trusted startup management: fixed reviewed SQL, called only before HTTP registration.
# No request SQL string or dynamic Query factory is exposed.
async def bootstrap_items(pool: view[sqlite.Pool]) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("CREATE TABLE sample_items(id INTEGER PRIMARY KEY, name TEXT NOT NULL)"), sqlite.parameters())
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

# Trusted startup management: fixed reviewed SQL, called only before HTTP registration.
# No request SQL string or dynamic Query factory is exposed.
async def seed_items(pool: view[sqlite.Pool]) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("INSERT INTO sample_items(id, name) VALUES (1, 'notebook')"), sqlite.parameters())
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)
