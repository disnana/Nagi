import std.db.sqlite as sqlite
import std.result as result
# API routes remain available while the former raw-HTML UI waits for typed HTML.
import "models.nagi"
import "validation.nagi"
import std.http.server as http

class State:
    db: sqlite.Pool

def task_id(request: view[http.Request]) -> Result[i64, Error]:
    if len(request.path) <= 11:
        return error("id must be positive")
    return parse_i64(try slice(request.path, 11, len(request.path)))

async def home(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return ok(http.text(http.Status.OK, "Task JSON API is available at /api/tasks."))

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return ok(http.text(http.Status.OK, "ok"))

async def list_tasks(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    rows = try await storage_list_tasks(view(state.db))
    return http.json[List[Task]](http.Status.OK, rows)

async def get_task(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try task_id(view(request))
    if id < 1:
        return error("id must be positive")
    match await storage_get_task(view(state.db), id):
        case Ok(found):
            match found:
                case Some(task):
                    return http.json[Task](http.Status.OK, task)
                case None:
                    return ok(http.empty(http.Status.NOT_FOUND))
        case Err(problem):
            return fail(problem)

async def create_task(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    input = try json_decode[SaveTask](request.body)
    try validate_task(view(input.title))
    done: i32 = 0
    if input.done:
        done = 1
    task = try await storage_create_task(view(state.db), input.title, done)
    return http.json[Task](http.Status.OK, task)

async def update_task(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try task_id(view(request))
    if id < 1:
        return error("id must be positive")
    input = try json_decode[SaveTask](request.body)
    try validate_task(view(input.title))
    done: i32 = 0
    if input.done:
        done = 1
    task = try await storage_update_task(view(state.db), id, input.title, done)
    return http.json[Task](http.Status.OK, task)

async def delete_task(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    id = try task_id(view(request))
    if id < 1:
        return error("id must be positive")
    deleted = try await storage_delete_task(view(state.db), id)
    return http.json[i64](http.Status.OK, deleted)

async def stats(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    match await storage_task_stats(view(state.db), 0):
        case Ok(found):
            match found:
                case Some(value):
                    return http.json[TaskStats](http.Status.OK, value)
                case None:
                    return ok(http.empty(http.Status.NOT_FOUND))
        case Err(problem):
            return fail(problem)

async def main() -> Result[unit, Error]:
    port = try parse_i64(env("NAGI_PORT", "8091"))
    if port < 1 or port > 65535:
        return error("NAGI_PORT must be between 1 and 65535")
    db = try await open_database(view(env("NAGI_DB", "nagi-tasks.sqlite")))
    try await bootstrap_tasks(view(db))
    app = http.app_default[State](State(db=db))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    app = try http.route(app, http.Method.GET, "/", http.public_policy[State](), home)
    app = try http.route(app, http.Method.GET, "/api/tasks", http.public_policy[State](), list_tasks)
    app = try http.route(app, http.Method.GET, "/api/tasks/{id}", http.public_policy[State](), get_task)
    app = try http.route(app, http.Method.POST, "/api/tasks", http.public_policy[State](), create_task)
    app = try http.route(app, http.Method.PUT, "/api/tasks/{id}", http.public_policy[State](), update_task)
    app = try http.route(app, http.Method.DELETE, "/api/tasks/{id}", http.public_policy[State](), delete_task)
    app = try http.route(app, http.Method.GET, "/api/stats", http.public_policy[State](), stats)
    print("Task JSON API ready on 127.0.0.1")
    return await http.serve(app, port, http.default_options())

# This HTTP-facing projection preserves the primary Error. The SQLite Failure
# (outcome, cleanup and retired metadata) stays observable in database APIs.
def sqlite_error(problem: sqlite.Failure) -> Error:
    match sqlite.copy_primary_error(view(problem)):
        case Some(cause):
            return cause
        case None:
            fallback: Result[Error, Error] = internal_error("SQLite operation failed")
            match fallback:
                case Ok(cause):
                    return cause
                case Err(cause):
                    return cause

async def open_database(path: view[str]) -> Result[sqlite.Pool, Error]:
    # Explicit example limits: one connection, two queued Tx commands,
    # 1000 ms acquisition and no native busy wait.
    config = try sqlite.options(1, 2, 1000, 0)
    return result.map_error(await sqlite.open(path, config), sqlite_error)

async def storage_list_tasks(pool: view[sqlite.Pool]) -> Result[List[Task], Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.all[Task](tx, sqlite.literal("SELECT id, title, done FROM demo_tasks ORDER BY id DESC LIMIT 100"), sqlite.parameters())
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_get_task(pool: view[sqlite.Pool], value0: i64) -> Result[Task?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[Task](tx, sqlite.literal("SELECT id, title, done FROM demo_tasks WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_create_task(pool: view[sqlite.Pool], value0: str, value1: i32) -> Result[Task, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    try result.map_error(await sqlite.exec(tx, sqlite.literal("INSERT INTO demo_tasks(title, done) VALUES (?, ?)"), sqlite.bind_i64(sqlite.bind_text(sqlite.parameters(), value0), i64(value1))), sqlite_error)
    found = try result.map_error(await sqlite.query[Task](tx, sqlite.literal("SELECT id, title, done FROM demo_tasks WHERE id = last_insert_rowid()"), sqlite.parameters()), sqlite_error)
    match found:
        case Some(value):
            try result.map_error(await sqlite.commit(tx), sqlite_error)
            return ok(value)
        case None:
            try result.map_error(await sqlite.rollback(tx), sqlite_error)
            return not_found("database row not found")

async def storage_update_task(pool: view[sqlite.Pool], value0: i64, value1: str, value2: i32) -> Result[Task, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    try result.map_error(await sqlite.exec(tx, sqlite.literal("UPDATE demo_tasks SET title = ?, done = ? WHERE id = ?"), sqlite.bind_i64(sqlite.bind_i64(sqlite.bind_text(sqlite.parameters(), value1), i64(value2)), value0)), sqlite_error)
    found = try result.map_error(await sqlite.query[Task](tx, sqlite.literal("SELECT id, title, done FROM demo_tasks WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0)), sqlite_error)
    match found:
        case Some(value):
            try result.map_error(await sqlite.commit(tx), sqlite_error)
            return ok(value)
        case None:
            try result.map_error(await sqlite.rollback(tx), sqlite_error)
            return not_found("database row not found")

async def storage_delete_task(pool: view[sqlite.Pool], value0: i64) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("DELETE FROM demo_tasks WHERE id = ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

async def storage_task_stats(pool: view[sqlite.Pool], value0: i64) -> Result[TaskStats?, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.DEFERRED), sqlite_error)
    work = await sqlite.query[TaskStats](tx, sqlite.literal("SELECT COUNT(*) AS total, COALESCE(SUM(done), 0) AS completed FROM demo_tasks WHERE id > ?"), sqlite.bind_i64(sqlite.parameters(), value0))
    ending = await sqlite.rollback(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)

# Trusted startup management: fixed reviewed SQL, called only before HTTP registration.
# No request SQL string or dynamic Query factory is exposed.
async def bootstrap_tasks(pool: view[sqlite.Pool]) -> Result[i64, Error]:
    tx = try result.map_error(await sqlite.begin(pool, sqlite.BeginMode.IMMEDIATE), sqlite_error)
    work = await sqlite.exec(tx, sqlite.literal("CREATE TABLE IF NOT EXISTS demo_tasks(id INTEGER PRIMARY KEY, title TEXT NOT NULL CHECK(length(CAST(title AS BLOB)) BETWEEN 1 AND 240), done INTEGER NOT NULL CHECK(done IN (0, 1)))"), sqlite.parameters())
    ending = await sqlite.commit(tx)
    value = try result.map_error(work, sqlite_error)
    try result.map_error(ending, sqlite_error)
    return ok(value)
