+        let mut rust_types = BTreeMap::new();
+        fn add(t: &Type, out: &mut BTreeSet<Type>) {
+            out.insert(t.clone());
+            for inner in &t.1 {
+                add(inner, out);
+            }
+        }
+        fn statements(ss: &[Stmt], out: &mut BTreeSet<Type>) {
+            for s in ss {
+                if let Some(t) = &s.binding_type {
+                    add(t, out);
+                }
+                match &s.kind {
+                    S::Assign {
+                        annotation: Some(t),
+                        ..
+                    }
+                    | S::SpawnBind {
+                        annotation: Some(t),
+                        ..
+                    } => add(t, out),
+                    S::If(_, a, b) => {
+                        statements(a, out);
+                        statements(b, out);
+                    }
+                    S::While(_, b) | S::For(_, _, b) | S::Scope(b) => statements(b, out),
+                    S::Match(_, arms) => {
+                        for a in arms {
+                            for b in a.pattern.bindings() {
+                                if let Some(t) = &b.ty {
