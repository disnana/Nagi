+impl ExpressionKey {
+    pub(crate) fn of(e: &Expr) -> Self {
+        let kind = match e.kind {
+            E::Int(_) => 0,
+            E::Float(_) => 1,
+            E::Str(_) => 2,
+            E::Bool(_) => 3,
+            E::Null => 4,
+            E::Name(_) => 5,
+            E::Binary(..) => 6,
+            E::Unary(..) => 7,
+            E::Call(..) => 8,
+            E::Record(..) => 9,
+            E::Field(..) => 10,
+            E::Index(..) => 11,
+            E::List(..) => 12,
+            E::Await(..) => 13,
+            E::Try(..) => 14,
+        };
+        Self {
+            use_id: ExprUseId::of(e),
+            kind,
+        }
+    }
