+                        if e.resolution == Some(NameResolution::Standard)
+                            && crate::stdlib::operation(n)
+                                == Some(crate::stdlib::Operation::TaskDiscard) =>
+                    {
+                        Some(TaskAction::Discard)
+                    }
+                    _ => None,
