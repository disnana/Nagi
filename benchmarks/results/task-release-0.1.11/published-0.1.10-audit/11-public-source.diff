+        | S::Spawn(expr)
+        | S::If(expr, _, _)
+        | S::Match(expr, _)
+        | S::While(expr, _)
+        | S::For(_, expr, _) => expression_names(expr, &mut names),
+        S::Return(None) | S::Scope(_) => {}
+    }
