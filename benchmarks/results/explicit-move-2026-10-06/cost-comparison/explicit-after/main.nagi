from std.ownership import move
@rust("native::observe")
extern def observe()
@rust("native::pause")
extern async def pause()

async def arrange(text: view[str]) -> List[view[str]]:
    parts = [text]
    saved = move(parts)
    local = copy(text)
    parts = [view(local)]
    parts = move(saved)
    await pause()
    return parts

def main():
    observe()
