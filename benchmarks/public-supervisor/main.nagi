# This program, not a hand-written Tokio actor, owns every benchmark child.
import std.actor as actor

@rust("native::checkpoint")
extern def checkpoint(stage: i64) -> unit
@rust("native::begin_phase")
extern def begin_phase(phase: i64) -> unit
@rust("native::record")
extern def record(client: i64, start: i64, end: i64, success: bool) -> unit
@rust("native::end_phase")
extern def end_phase(phase: i64) -> unit
@rust("native::fault_mark")
extern def fault_mark(complete: bool, time: i64) -> unit

async def factory(context: shared[unit]) -> Result[i64, Error]:
    return ok(0)

async def handler(state: i64, message: i64) -> Result[actor.Turn[i64, i64, Error], Error]:
    if message < 0:
        return error("owned benchmark worker failure")
    next = state + message
    return ok(actor.turn[i64, i64, Error](next, ok(next)))

async def monitor(group: actor.Supervisor[unit]) -> Result[unit, Error]:
    return await actor.run(group)

async def client(worker: actor.Actor[i64, i64, Error], index: i64, iterations: i64) -> Result[unit, Error]:
    for i in range(iterations):
        start = clock_ns()
        success = False
        match await actor.call(view(worker), 1, 1000, 1000):
            case Ok(reply):
                match reply:
                    case Ok(value):
                        assert_true(value > 0)
                        success = True
                    case Err(_):
                        assert_true(True)
            case Err(_):
                assert_true(True)
        record(index, start, clock_ns(), success)
    return ok(assert_true(True))

async def fail_once(worker: actor.Actor[i64, i64, Error], control: actor.Control) -> Result[unit, Error]:
    fault_mark(False, clock_ns())
    match await actor.call(view(worker), -1, 1000, 1000):
        case Ok(_):
            return error("faulted worker returned a reply")
        case Err(problem):
            assert_true(problem.kind == actor.CallKind.REPLY_LOST)
    restarted = False
    count = 0
    while not restarted and count < 16:
        count = count + 1
        match await actor.next_event_timeout(view(control), 1000):
            case Ok(next):
                match next:
                    case Some(event):
                        assert_true(event.kind != actor.EventKind.LAGGED)
                        if event.kind == actor.EventKind.STARTED and event.child_name == "0" and event.generation == 2:
                            restarted = True
                    case None:
                        return error("supervisor stopped before benchmark recovery")
            case Err(_):
                return error("benchmark recovery event deadline")
    assert_true(restarted)
    match await actor.call(view(worker), 0, 1000, 1000):
        case Ok(reply):
            match reply:
                case Ok(value):
                    assert_true(value == 0)
                case Err(_):
                    return error("recovered actor returned business failure")
        case Err(_):
            return error("recovered actor unavailable")
    fault_mark(True, clock_ns())
    return ok(assert_true(True))

async def drive(first: actor.Actor[i64, i64, Error], second: actor.Actor[i64, i64, Error], third: actor.Actor[i64, i64, Error], idle: List[actor.Actor[i64, i64, Error]], control: actor.Control, count: i64, iterations: i64) -> Result[unit, Error]:
    for worker in idle:
        match await actor.ready(view(worker), 5000):
            case Ok(_):
                assert_true(True)
            case Err(_):
                return error("idle actor did not become ready")
    match await actor.ready(view(first), 5000):
        case Ok(_):
            assert_true(True)
        case Err(_):
            return error("first actor did not become ready")
    match await actor.ready(view(second), 5000):
        case Ok(_):
            assert_true(True)
        case Err(_):
            return error("second actor did not become ready")
    match await actor.ready(view(third), 5000):
        case Ok(_):
            assert_true(True)
        case Err(_):
            return error("third actor did not become ready")
    # Drain this generation's startup events before measuring failure recovery.
    starts = 0
    started = 0
    for i in range(count * 2):
        match await actor.next_event_timeout(view(control), 1000):
            case Ok(next):
                match next:
                    case Some(event):
                        assert_true(event.generation == 1)
                        if event.kind == actor.EventKind.STARTING:
                            starts = starts + 1
                        else:
                            if event.kind == actor.EventKind.STARTED:
                                started = started + 1
                            else:
                                return error("unexpected initial actor event")
                    case None:
                        return error("startup stream closed")
            case Err(_):
                return error("startup event deadline")
    assert_true(starts == count and started == count)
    checkpoint(1)
    for phase in range(3):
        begin_phase(phase)
        async with scope:
            spawn client(actor.clone_actor(view(second)), 0, iterations)
            spawn client(actor.clone_actor(view(third)), 1, iterations)
            if phase == 1 and count >= 3:
                spawn fail_once(actor.clone_actor(view(first)), actor.clone_control(view(control)))
        end_phase(phase)
    try await actor.shutdown(view(control))
    checkpoint(2)
    return ok(assert_true(True))

async def main() -> Result[unit, Error]:
    count = try parse_i64(env("NAGI_PROBE_ACTORS", "32"))
    iterations = try parse_i64(env("NAGI_PROBE_ITERATIONS", "20000"))
    assert_true((count == 1 or count >= 3) and count <= 512 and iterations >= 1 and iterations <= 20000)
    checkpoint(0)
    group = actor.supervisor[unit](assert_true(True), try actor.options(count, 4096, 2, 60000, 1000))
    first = try actor.register[i64, i64, i64, Error](view(group), "0", factory, handler, try actor.actor_options(64, 4096, 4096, 5000, actor.RestartPolicy.TRANSIENT))
    second = actor.clone_actor(view(first))
    third = actor.clone_actor(view(first))
    if count >= 3:
        second = try actor.register[i64, i64, i64, Error](view(group), "1", factory, handler, try actor.actor_options(64, 4096, 4096, 5000, actor.RestartPolicy.TRANSIENT))
        third = try actor.register[i64, i64, i64, Error](view(group), "2", factory, handler, try actor.actor_options(64, 4096, 4096, 5000, actor.RestartPolicy.TRANSIENT))
    idle: List[actor.Actor[i64, i64, Error]] = []
    for i in range(count - 3):
        name = try json_encode(i + 3)
        worker = try actor.register[i64, i64, i64, Error](view(group), view(name), factory, handler, try actor.actor_options(64, 4096, 4096, 5000, actor.RestartPolicy.TRANSIENT))
        append(idle, worker)
    control = actor.control(view(group))
    async with scope:
        spawn monitor(group)
        spawn drive(first, second, third, idle, control, count, iterations)
    await sleep(50)
    checkpoint(3)
    return ok(assert_true(True))
