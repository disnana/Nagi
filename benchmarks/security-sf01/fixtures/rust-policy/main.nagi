import std.auth as auth
import std.http.server as http

enum Read:
    Permission

class State:
    owner_subject: i64
    blocked: bool

class Document:
    id: i64
    title: str

@rust("native::verify")
extern async def verify(request: http.Request, state: shared[State]) -> Result[auth.VerifiedIdentity, auth.Failure]

@rust("native::authorize_read")
extern async def authorize_read(scope: auth.AuthScope, request: http.Request, state: shared[State]) -> Result[auth.Grant[Read], auth.Failure]

@rust("native::read_document")
extern async def read_document(grant: auth.Grant[Read]) -> Result[Document, auth.Failure]

@rust("native::report")
extern def report() -> unit

@rust("native::initialize")
extern def initialize() -> unit

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return http.text(http.response_context(view(request)), http.Status.OK, "ok")

async def show_document(request: http.Request, state: shared[State], grant: auth.Grant[Read]) -> Result[http.Response, Error]:
    match await read_document(grant):
        case Ok(document):
            return http.json[Document](http.response_context(view(request)), http.Status.OK, document)
        case Err(problem):
            return http.text(http.response_context(view(request)), http.Status.INTERNAL_SERVER_ERROR, auth.message(view(problem)))

async def main() -> Result[unit, Error]:
    initialize()
    app = http.app_default[State](State(owner_subject=7, blocked=false))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    health_rate = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/health", health_rate)
    policy = http.authorized_policy[State, Read](verify, authorize_read)
    app = try http.route(app, http.Method.GET, "/documents/{id}", policy, show_document)
    document_rate = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/documents/{id}", document_rate)
    port = try parse_i64(env("NAGI_SAMPLE_PORT", "8098"))
    options = try http.authority(
        http.default_options(),
        "https://localhost",
        [env("NAGI_HTTP_AUTHORITY", "127.0.0.1:8098")],
        1,
        256
    )
    # Match the Nagi-policy fixture's finite 32-request validation profile.
    # The per-route bucket starts at 1,000 and replenishes one token per second.
    response_budget = try http.response_limits(
        1048576, 8192, 32, 8192, 32, 65536, 64, 83886080,
        1024, 285212672, 8192, 32
    )
    options = try http.with_response_limits(options, response_budget)
    rate_budget = try http.rate_limits(64, 64, 4096, 4194304, 65536)
    options = try http.with_rate_limits(options, rate_budget)
    outcome = await http.serve(app, port, options)
    report()
    return outcome
