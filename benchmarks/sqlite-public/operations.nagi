import std.db.sqlite as sqlite

async def literal(tx: view[sqlite.Tx], value: i64) -> Result[i64, sqlite.Failure]:
    params = sqlite.bind_i64(sqlite.parameters(), value)
    return await sqlite.exec(tx, sqlite.literal("INSERT INTO data VALUES (?)"), params)

async def selected(tx: view[sqlite.Tx], sql: sqlite.Query, value: i64) -> Result[i64, sqlite.Failure]:
    params = sqlite.bind_i64(sqlite.parameters(), value)
    return await sqlite.exec(tx, sql, params)
