async def child(enabled: bool, first: i64, second: i64) -> Result[i64, i64]:
    if enabled:
        return ok(first * 10 + second)
    return ok(0)

async def main() -> Result[unit, Error]:
    left: i64 = 1
    flag: bool = True
    right: i64 = 7
    async with scope:
        handle = spawn child(flag, right, left)
        left = 11
        flag = False
        right = 22
        received = await handle
    return ok(print(left))
