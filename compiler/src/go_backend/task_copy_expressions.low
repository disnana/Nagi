async fn child(enabled: bool, first: i64, second: i64) -> Result[i64, i64] {
    assert_true(enabled);
    assert_true(first == 8);
    assert_true(second == 3);
    return ok(first * 10 + second);
}

async fn main() -> Result[unit, Error] {
    let left: i64 = 1;
    let flag: bool = true;
    let right: i64 = 7;
    scope {
        let handle = spawn child(not (flag == false) or (right + 9223372036854775807 > 0), right + left, left * 3);
        left = 11;
        flag = false;
        right = 22;
        let received = await handle;
    }
    return ok(print(left));
}
