import std.http.server as http;
record State { value: i64; }
record CorsPolicy { value: i64; }
async fn respond(request: http.Request,state: shared[State],proof: unit) -> Result[http.Response,Error] { return ok(http.text(http.Status.OK,"owned")); }
fn build(path: view[str]) -> Result[http.App[State,Error],Error] {
 let app = http.app_default[State](State(value=7));
 app = try http.route(app,http.Method.GET,path,http.public_policy[State](),respond);
 let cors = try http.cors_policy(["https://app.example.invalid"],["content-type"],http.CorsCredentials.ALLOW,0,2,128,2,64);
 return http.cors_route[State,Error](app,http.Method.GET,path,cors);
}
fn user_value() -> i64 { return CorsPolicy(value=9).value; }
fn main() -> unit { print(0); }
