import std.db.sqlite as sqlite;
record Nested { id: i64; }
record Row { child: Nested; }
# Previous Db manual-row entry is retired in SF05.
# Previous Db manual-row entry is retired in SF05.
# Previous Db manual-row entry is retired in SF05.
# Previous Db manual-row entry is retired in SF05.
async fn invalid(tx: sqlite.Tx) -> Result[unit, sqlite.Failure] {
    let rows: List[Row] = try await sqlite.all[Row](tx, sqlite.literal("SELECT child FROM items"), sqlite.parameters());
    return await sqlite.rollback(tx);
}
