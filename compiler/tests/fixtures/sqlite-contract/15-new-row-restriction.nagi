import std.db.sqlite as sqlite
class Nested:
    id: i64
class Row:
    child: Nested
# Previous Db manual-row entry is retired in SF05.
# Previous Db manual-row entry is retired in SF05.
# Previous Db manual-row entry is retired in SF05.
async def invalid(tx: sqlite.Tx) -> Result[unit, sqlite.Failure]:
    rows = try await sqlite.all[Row](tx, sqlite.literal("SELECT child FROM items"), sqlite.parameters())
    return await sqlite.rollback(tx)
