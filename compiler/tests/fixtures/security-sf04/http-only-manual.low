import std.http.server as web;
record HtmlDocument { value: i64; }
fn plain(request: web.Request) -> Result[web.Response, Error] {
    let context = web.response_context(view(request));
    let policy = web.public_policy[i64]();
    return web.text(context, web.Status.OK, "plain");
}
fn user_value() -> i64 { return HtmlDocument(value=9).value; }
