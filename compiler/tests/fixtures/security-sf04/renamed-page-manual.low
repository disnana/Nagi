import std.html as markup;
import std.http.server as web;
record HtmlDocument { value: i64; }
fn respond(request: web.Request, document: markup.HtmlDocument) -> Result[web.Response, Error] {
    let context = web.response_context(view(request));
    return web.html_response(context, web.Status.CREATED, document);
}
fn build_page(request: web.Request) -> Result[web.Response, Error] {
    let policy = try markup.policy("https://example.invalid");
    let text = try markup.text(view(policy), "通常の café & tea");
    let document = try markup.document(view(policy), "Renamed & checked", text);
    return respond(request, document);
}
fn user_value() -> i64 { return HtmlDocument(value=7).value; }
