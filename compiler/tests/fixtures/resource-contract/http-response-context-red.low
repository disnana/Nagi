import std.http.server as http;

record State { count: i64; }
record Payload { label: str; }

fn app_mapper(context: view[http.ResponseContext], error: Error) -> Result[http.Response, Error] {
    return http.empty(context, http.Status.INTERNAL_SERVER_ERROR);
}

fn encode(request: http.Request, payload: Payload) -> Result[http.Response, Error] {
    let context = http.response_context(view(request));
    return http.json[Payload](context, http.Status.OK, payload);
}

fn setup(state: State) -> Result[http.App[State, Error], Error] {
    let app = http.app[State, Error](state, app_mapper);
    return ok(app);
}
