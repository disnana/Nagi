import std.http.server as http

class State:
    count: i64

class Payload:
    label: str

def app_mapper(context: view[http.ResponseContext], error: Error) -> Result[http.Response, Error]:
    return http.empty(context, http.Status.INTERNAL_SERVER_ERROR)

def encode(request: http.Request, payload: Payload) -> Result[http.Response, Error]:
    context = http.response_context(view(request))
    return http.json[Payload](context, http.Status.OK, payload)

def setup(state: State) -> Result[http.App[State, Error], Error]:
    app = http.app[State, Error](state, app_mapper)
    return ok(app)
