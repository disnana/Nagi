import std.auth.session as session;
import std.auth as auth;
import std.http.server as http;
import std.db.sqlite as sqlite;
record State { store: session.Store; }
async fn startup(pool: view[sqlite.Pool]) -> Result[session.Store, session.Failure] {
 let options = try session.options(4,5,72,1,10000,100000,5000,2);
 let cookie = try session.cookie_options("__Host-owned",session.SameSite.STRICT);
 return await session.open(pool,options,cookie);
}
fn shared_state(store: view[session.Store]) -> shared[State] { return share(State(store = session.clone_store(store))); }
fn main() -> unit { print(0); }

async fn inspect(request: http.Request,state: shared[State],scope: auth.AuthScope) -> Result[http.Response,Error] { return ok(http.empty(http.Status.OK)); }
fn read_registration(store: view[session.Store]) -> Result[http.App[State,Error],Error] {
 let app = http.app_default[State](State(store = session.clone_store(store)));
 let policy = http.session_authenticated_policy[State](session.clone_store(store));
 return http.route(app,http.Method.GET,"/owned",policy,inspect);
}
fn unsafe_registration(store: view[session.Store]) -> Result[http.App[State,Error],Error] {
 let app = http.app_default[State](State(store = session.clone_store(store)));
 let policy = http.session_authenticated_policy[State](session.clone_store(store));
 return http.route(app,http.Method.POST,"/owned",policy,inspect);
}
