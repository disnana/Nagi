import std.auth.session as session
import std.auth as auth
import std.http.server as http
class State:
    count: i64
enum Read:
    Allowed
async def authorize(scope: auth.AuthScope, request: http.Request, state: shared[State]) -> Result[auth.Grant[Read], auth.Failure]:
    return fail(auth.denied())
def policies(store: view[session.Store]) -> http.Policy[State, auth.AuthScope]:
    return http.session_authenticated_policy[State](session.clone_store(store))
def authorized(store: view[session.Store]) -> http.Policy[State, auth.Grant[Read]]:
    return http.session_authorized_policy[State, Read](session.clone_store(store), authorize)
def message(failure: view[session.Failure]) -> view[str]:
    return session.message(failure)
def outcome(failure: view[session.Failure]) -> i64:
    classification = session.kind(failure)
    completed = session.outcome(failure)
    return 0
def main():
    print(0)
