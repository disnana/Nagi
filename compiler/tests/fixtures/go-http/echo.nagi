import std.http.server as http

class State:
    greeting: str

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    assert_true(len(request.body) == 0)
    return http.text(http.response_context(view(request)), http.Status.OK, view(state.greeting))

async def echo(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return http.bytes(http.response_context(view(request)), http.Status.OK, request.body)

async def main() -> Result[unit, Error]:
    assert_true(len(try json_encode("x")) == 3)
    app = http.app_default[State](State(greeting="ready"))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    health_rate = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/health", health_rate)
    app = try http.route(app, http.Method.POST, "/echo", http.public_policy[State](), echo)
    echo_rate = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.POST, "/echo", echo_rate)
    port = try parse_i64(env("NAGI_SAMPLE_PORT", "8096"))
    wire_authority = env("NAGI_HTTP_AUTHORITY", "127.0.0.1:8096")
    body_limit = try parse_i64(env("NAGI_HTTP_BODY_LIMIT", "0"))
    limits = http.default_options()
    if body_limit > 0:
        limits = try http.options(body_limit, 5000, 2000, 1000)
    limits = try http.authority(limits, "https://localhost", [wire_authority], 1, 256)
    response_budget = try http.response_limits(1048576, 8192, 32, 8192, 32, 1, 64, 83886080, 1024, 285212672, 8192, 32)
    limits = try http.with_response_limits(limits, response_budget)
    rate_budget = try http.rate_limits(64, 64, 4096, 4194304, 65536)
    limits = try http.with_rate_limits(limits, rate_budget)
    return await http.serve(app, port, limits)
