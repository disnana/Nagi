from std.task import discard
def truth(done: unit) -> bool:
    return True
def text(done: unit) -> str:
    return "NAGI_CRITICAL_PRESENT"
async def work() -> i64:
    return 42
async def main() -> Result[unit, Error]:
    async with scope:
        task = spawn work() # primary
        value = env("NAGI_CRITICAL_PRESENT", env("NAGI_CRITICAL_MISSING", text(discard(task))))
        print(value)
    return ok(print("scope-ok"))
