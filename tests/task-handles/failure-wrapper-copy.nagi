async def work() -> i64:
    return 7
async def main() -> Result[unit, Error]:
    async with scope:
        task = spawn work()
        received = await task
        match received:
            case Ok(value):
                print(value)
            case Err(failure):
                failures = [some(failure)]
                copied = copy(view(failures))  # primary
    return ok(print(0))
