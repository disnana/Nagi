from std.task import TaskFailure;
fn take(result: Result[str,TaskFailure]) -> bool { return True; }
async fn work() -> str { return "payload"; }
async fn exercise(flag: bool) -> Result[unit,Error] {
    scope {
        let task = spawn work(); # primary
        let value = flag and take(await task);
        print(value);
    }
    return ok(print(0));
}
