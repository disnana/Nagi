async fn work() -> i64 { return 7; }
async fn main() -> Result[unit,Error] {
    scope {
        let task = spawn work(); let received = await task;
        match received {
            case Ok(value) { print(value); }
            case Err(failure) {
                let failures = [some(failure)];
                let copied = copy(view(failures)); # primary
            }
        }
    }
    return ok(print(0));
}
