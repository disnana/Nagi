from std.task import discard
async def work() -> i64:
    return 7
async def exercise(flag: bool) -> Result[unit, Error]:
    choice: Option[i64] = None
    if flag:
        choice = some(1)
    async with scope:
        task = spawn work()
        match choice:
            case Some(number):
                received = await task
                match received:
                    case Ok(value):
                        assert_true(value == 7)
                    case Err(failure):
                        assert_true(False)
            case None:
                discard(task)
        number = 0
        while number < 2:
            task = spawn work()
            received = await task
            match received:
                case Ok(value):
                    assert_true(value == 7)
                case Err(failure):
                    assert_true(False)
            number = number + 1
    return ok(print(0))
