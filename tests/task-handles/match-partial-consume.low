from std.task import discard;
async fn work() -> i64 { return 7; }
async fn main() -> Result[unit, Error] {
    scope {
        let task = spawn work(); # primary
        let choice: Option[i64] = some(1);
        match choice {
            case Some(number) { discard(task); }
            case None { print(0); }
        }
    }
    return ok(print(0));
}
