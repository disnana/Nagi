# 小さな在庫管理API。HTTP -> 型付きclass -> SQLite -> JSONを一通り使う。
# 現行のDB APIの引数形式(str, i32)に合わせ、商品名と在庫数を保存する。
class Item:
    id: i64
    name: str
    quantity: i32

class SaveItem:
    name: str
    quantity: i32

class InventorySummary:
    item_count: i64
    total_quantity: i64
    out_of_stock: i64

class DeleteResult:
    id: i64
    deleted: bool

# viewで名前を借用し、検証のためだけの文字列コピーを避ける。
# len(str)は文字数ではなくUTF-8のbyte数。
def validate_item(name: view[str], quantity: i32) -> Result[bool, Error]:
    if len(name) == 0 or len(name) > 120:
        return error("name must be between 1 and 120 UTF-8 bytes")
    if quantity < 0 or quantity > 1000000:
        return error("quantity must be between 0 and 1000000")
    return ok(true)

def validate_id(id: i64) -> Result[bool, Error]:
    if id <= 0:
        return error("id must be positive")
    return ok(true)

# 一覧は最新100件まで。全件の集計は別のendpointでSQLに任せる。
@get("/items")
async def list_items(db: Db) -> Result[List[Item], Error]:
    return await db_all[Item](db, "SELECT id, name, quantity FROM sample_inventory_items ORDER BY id DESC LIMIT 100")

@get("/items/{id}")
async def get_item(db: Db, id: i64) -> Result[Item?, Error]:
    try validate_id(id)
    # 見つからなければNone。HTTP層が404に変換する。
    return await db_query[Item](db, "SELECT id, name, quantity FROM sample_inventory_items WHERE id = ?1", id)

@post("/items")
async def create_item(db: Db, req: SaveItem) -> Result[Item, Error]:
    try validate_item(view(req.name), req.quantity)
    # 値はSQLへ連結せずbindする。名前の所有権をDB workerへ渡す。
    return await db_insert[Item](db, "INSERT INTO sample_inventory_items(name, quantity) VALUES (?1, ?2) RETURNING id, name, quantity", req.name, req.quantity)

@put("/items/{id}")
async def update_item(db: Db, id: i64, req: SaveItem) -> Result[Item, Error]:
    try validate_id(id)
    try validate_item(view(req.name), req.quantity)
    # 商品名と在庫数を両方指定する置換更新。存在しないIDは404。
    return await db_update[Item](db, "UPDATE sample_inventory_items SET name = ?2, quantity = ?3 WHERE id = ?1 RETURNING id, name, quantity", id, req.name, req.quantity)

@delete("/items/{id}")
async def delete_item(db: Db, id: i64) -> Result[DeleteResult, Error]:
    try validate_id(id)
    affected = try await db_write(db, "DELETE FROM sample_inventory_items WHERE id = ?1", id)
    # 再度削除しても200。deleted=falseで既に存在しなかったことを示す。
    return ok(DeleteResult(id=id, deleted=affected > 0))

@get("/inventory/summary")
async def inventory_summary(db: Db) -> Result[InventorySummary?, Error]:
    # 空のDBでもSUMを0へ変換。集計は一覧の100件制限に影響されない。
    return await db_query[InventorySummary](db, "SELECT COUNT(*) AS item_count, COALESCE(SUM(quantity), 0) AS total_quantity, COALESCE(SUM(CASE WHEN quantity = 0 THEN 1 ELSE 0 END), 0) AS out_of_stock FROM sample_inventory_items WHERE id > ?1", 0)

async def main() -> Result[unit, Error]:
    path = env("NAGI_DB", ":memory:")
    port = try parse_i64(env("NAGI_PORT", "8090"))
    if port < 1 or port > 65535:
        return error("NAGI_PORT must be between 1 and 65535")
    db = try await db_open(path)
    # Highの検証だけでなくDBにも制約を持たせる。
    try await db_exec(db, "CREATE TABLE IF NOT EXISTS sample_inventory_items(id INTEGER PRIMARY KEY, name TEXT NOT NULL CHECK(length(CAST(name AS BLOB)) BETWEEN 1 AND 120), quantity INTEGER NOT NULL CHECK(quantity BETWEEN 0 AND 1000000))")
    print("Inventory API ready on 127.0.0.1")
    print(port)
    return await serve(db, port)
