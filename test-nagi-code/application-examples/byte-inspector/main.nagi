import std.http.server as http

class State:
    description: str

class Summary:
    length: i64
    total: i64
    first: i64?

def summarize(data: view[bytes]) -> Summary:
    total = 0
    for byte in data:
        total += i64(byte)
    first: i64? = None
    if len(data) > 0:
        first = some(i64(data[0]))
    return Summary(length=len(data), total=total, first=first)

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return http.text(http.response_context(view(request)), http.Status.OK, view(state.description))

async def inspect(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    value = summarize(request.body)
    return http.json[Summary](http.response_context(view(request)), http.Status.OK, value)

async def main() -> Result[unit, Error]:
    app = http.app_default[State](State(description="byte inspector"))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    route_policy_1 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.GET, "/health", route_policy_1)
    app = try http.route(app, http.Method.POST, "/bytes", http.public_policy[State](), inspect)
    route_policy_2 = try http.rate_policy(1000, 1000)
    app = try http.rate_route(app, http.Method.POST, "/bytes", route_policy_2)
    port = try parse_i64(env("NAGI_SAMPLE_PORT", "8096"))
    limits = try http.options(4096, 5000, 2000, 1000)
    wire_authority = env("NAGI_HTTP_AUTHORITY", "127.0.0.1:8096")
    limits = try http.authority(limits, "https://localhost", [wire_authority], 1, 256)
    # Explicit illustrative profile only; not a production sizing or SLA recommendation.
    response_budget = try http.response_limits(
        1048576, 8192, 32, 8192, 32, 65536, 64, 83886080, 1024, 285212672, 8192, 32
    )
    limits = try http.with_response_limits(limits, response_budget)
    rate_budget = try http.rate_limits(64, 64, 4096, 4194304, 65536)
    limits = try http.with_rate_limits(limits, rate_budget)
    return await http.serve(app, port, limits)
