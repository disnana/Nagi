import std.http.server as http

class State:
    description: str

class Summary:
    length: i64
    total: i64
    first: i64?

def summarize(data: view[bytes]) -> Summary:
    total = 0
    for byte in data:
        total += i64(byte)
    first: i64? = None
    if len(data) > 0:
        first = some(i64(data[0]))
    return Summary(length=len(data), total=total, first=first)

async def health(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    return ok(http.text(http.Status.OK, view(state.description)))

async def inspect(request: http.Request, state: shared[State], authority: unit) -> Result[http.Response, Error]:
    value = summarize(request.body)
    return http.json[Summary](http.Status.OK, value)

async def main() -> Result[unit, Error]:
    app = http.app_default[State](State(description="byte inspector"))
    app = try http.route(app, http.Method.GET, "/health", http.public_policy[State](), health)
    app = try http.route(app, http.Method.POST, "/bytes", http.public_policy[State](), inspect)
    port = try parse_i64(env("NAGI_SAMPLE_PORT", "8096"))
    limits = try http.options(4096, 5000, 2000, 1000)
    wire_authority = env("NAGI_HTTP_AUTHORITY", "127.0.0.1:8096")
    limits = try http.authority(limits, "https://localhost", [wire_authority], 1, 256)
    return await http.serve(app, port, limits)
