import std.http.server as http
import std.result as result

class Config:
    currency: str
    unit_price_minor: i64
    shipping_minor: i64
    free_shipping_quantity: i64
    maximum_quantity: i64

class QuoteInput:
    sku: str
    quantity: i64

class Quote:
    sku: str
    quantity: i64
    currency: str
    unit_price_minor: i64
    subtotal_minor: i64
    shipping_minor: i64
    total_minor: i64

class Health:
    status: str
    currency: str
    maximum_quantity: i64

enum QuoteError:
    InvalidRequestId
    InvalidHeader
    UnsupportedMediaType
    InvalidJson
    InvalidQuantity
    UnknownSku
    Internal

class ApiFailure:
    problem: QuoteError
    request_id: str

class ErrorBody:
    code: str
    message: str

def with_request_id(response: http.Response, request_id: view[str]) -> Result[http.Response, Error]:
    if len(request_id) == 0:
        return ok(response)
    return http.append_header_text(response, "X-Request-ID", request_id)

def error_response(status: http.Status, code: str, message: str, request_id: view[str]) -> http.Response:
    payload = ErrorBody(code=code, message=message)
    match http.json[ErrorBody](status, payload):
        case Ok(response):
            match with_request_id(response, request_id):
                case Ok(output):
                    return output
                case Err(_):
                    return http.empty(http.Status.INTERNAL_SERVER_ERROR)
        case Err(_):
            return http.empty(http.Status.INTERNAL_SERVER_ERROR)

def api_failure(failure: ApiFailure) -> http.Response:
    match failure.problem:
        case QuoteError.InvalidRequestId:
            return error_response(http.Status.BAD_REQUEST, "invalid_request_id", "X-Request-ID must contain one UUID", view(failure.request_id))
        case QuoteError.InvalidHeader:
            return error_response(http.Status.BAD_REQUEST, "invalid_header", "Content-Type must contain one valid media type", view(failure.request_id))
        case QuoteError.UnsupportedMediaType:
            return error_response(http.Status.UNSUPPORTED_MEDIA_TYPE, "unsupported_media_type", "Content-Type must be application/json", view(failure.request_id))
        case QuoteError.InvalidJson:
            return error_response(http.Status.BAD_REQUEST, "invalid_json", "Expected exactly sku:string and quantity:integer", view(failure.request_id))
        case QuoteError.InvalidQuantity:
            return error_response(http.Status.UNPROCESSABLE_CONTENT, "invalid_quantity", "Quantity is outside the configured range", view(failure.request_id))
        case QuoteError.UnknownSku:
            return error_response(http.Status.UNPROCESSABLE_CONTENT, "unknown_sku", "Only NOTEBOOK is available", view(failure.request_id))
        case QuoteError.Internal:
            return error_response(http.Status.INTERNAL_SERVER_ERROR, "internal_error", "Unable to create response", view(failure.request_id))

def health_failure(problem: Error) -> http.Response:
    return error_response(http.Status.INTERNAL_SERVER_ERROR, "internal_error", "Unable to create response", view(""))

def read_request_id(request: view[http.Request]) -> Result[str, ApiFailure]:
    match http.header_text(request, "X-Request-ID"):
        case Ok(header):
            match header:
                case Some(value):
                    match uuid_parse(value):
                        case Ok(identifier):
                            return ok(uuid_format(identifier))
                        case Err(_):
                            return fail(ApiFailure(problem=QuoteError.InvalidRequestId, request_id=""))
                case None:
                    return ok("")
        case Err(_):
            return fail(ApiFailure(problem=QuoteError.InvalidRequestId, request_id=""))

def invalid_header(cause: Error) -> QuoteError:
    return QuoteError.InvalidHeader

def invalid_json(cause: Error) -> QuoteError:
    return QuoteError.InvalidJson

def response_error(cause: Error) -> QuoteError:
    return QuoteError.Internal

def require_json(request: view[http.Request]) -> Result[unit, QuoteError]:
    matches = try result.map_error(http.is_json_content_type(request), invalid_header)
    if matches:
        return ok(assert_true(True))
    return fail(QuoteError.UnsupportedMediaType)

def read_input(body: view[bytes]) -> Result[QuoteInput, QuoteError]:
    return result.map_error(json_decode[QuoteInput](body), invalid_json)

def calculate(input: QuoteInput, config: shared[Config]) -> Result[Quote, QuoteError]:
    if input.quantity < 1 or input.quantity > config.maximum_quantity:
        return fail(QuoteError.InvalidQuantity)
    if view(input.sku) != "NOTEBOOK":
        return fail(QuoteError.UnknownSku)
    subtotal = input.quantity * config.unit_price_minor
    shipping = config.shipping_minor
    if input.quantity >= config.free_shipping_quantity:
        shipping = 0
    return ok(Quote(sku=input.sku, quantity=input.quantity, currency=copy(view(config.currency)), unit_price_minor=config.unit_price_minor, subtotal_minor=subtotal, shipping_minor=shipping, total_minor=subtotal + shipping))

def quote_response(request: http.Request, config: shared[Config]) -> Result[http.Response, QuoteError]:
    try require_json(view(request))
    input = try read_input(request.body)
    value = try calculate(input, config)
    return result.map_error(http.json[Quote](http.Status.OK, value), response_error)

async def quote(request: http.Request, config: shared[Config], authority: unit) -> Result[http.Response, ApiFailure]:
    request_id = try read_request_id(view(request))
    match quote_response(request, config):
        case Ok(response):
            match with_request_id(response, view(request_id)):
                case Ok(output):
                    return ok(output)
                case Err(_):
                    return fail(ApiFailure(problem=QuoteError.Internal, request_id=request_id))
        case Err(problem):
            return fail(ApiFailure(problem=problem, request_id=request_id))

async def health(request: http.Request, config: shared[Config], authority: unit) -> Result[http.Response, Error]:
    value = Health(status="ok", currency=copy(view(config.currency)), maximum_quantity=config.maximum_quantity)
    return http.json[Health](http.Status.OK, value)

async def main() -> Result[unit, Error]:
    maximum = try parse_i64(env("NAGI_SAMPLE_MAX_QUANTITY", "1000"))
    if maximum < 1 or maximum > 1000:
        return error("NAGI_SAMPLE_MAX_QUANTITY must be between 1 and 1000")
    config = Config(currency="USD", unit_price_minor=1250, shipping_minor=500, free_shipping_quantity=5, maximum_quantity=maximum)
    app = http.app[Config, ApiFailure](config, api_failure)
    app = try http.route(app, http.Method.POST, "/quotes", http.public_policy[Config](), quote)
    app = try http.route_mapped(app, http.Method.GET, "/health", http.public_policy[Config](), health, health_failure)
    port = try parse_i64(env("NAGI_SAMPLE_PORT", "8092"))
    limits = try http.options(4096, 5000, 2000, 1000)
    return await http.serve(app, port, limits)
