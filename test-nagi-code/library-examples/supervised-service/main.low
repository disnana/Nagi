# Hand-maintained Low input: ordinary imports resolve against the current registry.
# Saved/generated Low is tested separately by scripts/verify_library_examples.py.
import std.actor as actor;
import std.http.server as http;
import std.task as task;
record Context {
    initial: i64;
}

record CounterState {
    value: i64;
    label: str;
}

record WebState {
    counter: actor.Actor[Message, i64, CounterError];
    control: actor.Control;
}

enum Message {
    Read;
    Add(amount: i64);
}

enum CounterError {
    InvalidIncrement;
    LimitReached;
}

enum WebError {
    InvalidInput;
    Rejected;
    Unavailable;
}

async fn create_counter(context: shared[Context]) -> Result[CounterState, Error] {
    return ok(CounterState(value = context.initial, label = "counter"));
}

async fn update_counter(state: CounterState, message: Message) -> Result[actor.Turn[CounterState, i64, CounterError], Error] {
    match message {
        case Message.Read {
            let value: i64 = state.value;
            return ok(actor.turn[CounterState, i64, CounterError](state, ok(value)));
        }
        case Message.Add(amount) {
            if amount < 1 or amount > 1000 {
                return ok(actor.turn[CounterState, i64, CounterError](state, fail(CounterError.InvalidIncrement)));
            }
            if state.value > 1000000 - amount {
                return ok(actor.turn[CounterState, i64, CounterError](state, fail(CounterError.LimitReached)));
            }
            let value: i64 = state.value + amount;
            let next: CounterState = CounterState(value = value, label = state.label);
            return ok(actor.turn[CounterState, i64, CounterError](next, ok(value)));
        }
    }
}

fn number_response(value: i64) -> http.Response {
    match http.json[i64](http.Status.OK, value) {
        case Ok(response) {
            return response;
        }
        case Err(_) {
            return http.empty(http.Status.INTERNAL_SERVER_ERROR);
        }
    }
}

fn web_error(problem: WebError) -> http.Response {
    match problem {
        case WebError.InvalidInput {
            return http.text(http.Status.BAD_REQUEST, "send a JSON integer");
        }
        case WebError.Rejected {
            return http.text(http.Status.CONFLICT, "increment must be 1..1000 and total at most 1000000");
        }
        case WebError.Unavailable {
            return http.text(http.Status.SERVICE_UNAVAILABLE, "counter unavailable");
        }
    }
}

async fn execute(counter: view[actor.Actor[Message, i64, CounterError]], message: Message) -> Result[http.Response, WebError] {
    match await actor.call(counter, message, 0, 1000) {
        case Ok(reply) {
            match reply {
                case Ok(value) {
                    return ok(number_response(value));
                }
                case Err(_) {
                    return fail(WebError.Rejected);
                }
            }
        }
        case Err(_) {
            return fail(WebError.Unavailable);
        }
    }
}

async fn read_counter(request: http.Request, state: shared[WebState], authority: unit) -> Result[http.Response, WebError] {
    return await execute(view(state.counter), Message.Read);
}

async fn increment(request: http.Request, state: shared[WebState], authority: unit) -> Result[http.Response, WebError] {
    match json_decode[i64](request.body) {
        case Ok(amount) {
            return await execute(view(state.counter), Message.Add(amount));
        }
        case Err(_) {
            return fail(WebError.InvalidInput);
        }
    }
}

async fn stop_counter(request: http.Request, state: shared[WebState], authority: unit) -> Result[http.Response, WebError] {
    match await actor.shutdown(view(state.control)) {
        case Ok(_) {
            return ok(http.empty(http.Status.NO_CONTENT));
        }
        case Err(_) {
            return fail(WebError.Unavailable);
        }
    }
}

async fn monitor(group: actor.Supervisor[Context]) -> Result[unit, Error] {
    return await actor.run(group);
}

async fn serve_web(app: http.App[WebState, WebError], ready: actor.Actor[Message, i64, CounterError], control: actor.Control, port: i64, options: http.Options) -> Result[unit, Error] {
    match await actor.ready(view(ready), 5000) {
        case Ok(_) {
            assert_true(true);
        }
        case Err(_) {
            try await actor.shutdown(view(control));
            return error("counter did not start");
        }
    }
    let outcome: Result[unit, Error] = await http.serve(app, port, options);
    try await actor.shutdown(view(control));
    return outcome;
}

async fn main() -> Result[unit, Error] {
    let port: i64 = try parse_i64(env("NAGI_SAMPLE_PORT", "8090"));
    let wire_authority: str = env("NAGI_HTTP_AUTHORITY", "localhost:8090");
    let options: http.Options = try http.authority(http.default_options(), "https://localhost", [wire_authority], 1, 256);
    let group: actor.Supervisor[Context] = actor.supervisor[Context](Context(initial = 0), actor.default_options());
    let counter: actor.Actor[Message, i64, CounterError] = try actor.register[CounterState, Message, i64, CounterError](view(group), "counter", create_counter, update_counter, actor.default_actor_options());
    let ready: actor.Actor[Message, i64, CounterError] = actor.clone_actor(view(counter));
    let control: actor.Control = actor.control(view(group));
    let server_control: actor.Control = actor.clone_control(view(control));
    let app: http.App[WebState, WebError] = http.app[WebState, WebError](WebState(counter = counter, control = control), web_error);
    app = try http.route(app, http.Method.GET, "/counter", http.public_policy[WebState](), read_counter);
    app = try http.route(app, http.Method.POST, "/counter", http.public_policy[WebState](), increment);
    app = try http.route(app, http.Method.POST, "/shutdown", http.public_policy[WebState](), stop_counter);
    scope {
        let monitor_task: task.Task[Result[unit, Error]] = spawn monitor(group);
        spawn serve_web(app, ready, server_control, port, options);
        let received: Result[Result[unit, Error], task.TaskFailure] = await monitor_task;
        match received {
            case Ok(inner) {
                try inner;
            }
            case Err(failure) {
                print(task.message(failure));
            }
        }
    }
    return ok(assert_true(true));
}
