<idea-plugin>
    <id>com.disnana.nagi</id>
    <name>Nagi for JetBrains</name>
    <vendor url="https://nagi.disnana.com">Disnana</vendor>
    <description><![CDATA[
        Nagi High and Low language support: highlighting, folding, indentation,
        and explicit compiler checks and project execution. Requires a separate Nagi compiler.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Nagi" language="Nagi" extensions="nagi"
                  implementationClass="com.disnana.nagi.NagiFileType" fieldName="HIGH"/>
        <fileType name="Nagi Low" language="NagiLow" extensions="low"
                  implementationClass="com.disnana.nagi.NagiFileType" fieldName="LOW"/>
        <lang.parserDefinition language="Nagi" implementationClass="com.disnana.nagi.NagiParserDefinition"/>
        <lang.parserDefinition language="NagiLow" implementationClass="com.disnana.nagi.NagiParserDefinition$Low"/>
        <lang.syntaxHighlighterFactory language="Nagi" implementationClass="com.disnana.nagi.NagiSyntaxHighlighter$Factory"/>
        <lang.syntaxHighlighterFactory language="NagiLow" implementationClass="com.disnana.nagi.NagiSyntaxHighlighter$LowFactory"/>
        <lang.commenter language="Nagi" implementationClass="com.disnana.nagi.NagiCommenter"/>
        <lang.commenter language="NagiLow" implementationClass="com.disnana.nagi.NagiCommenter"/>
        <lang.braceMatcher language="Nagi" implementationClass="com.disnana.nagi.NagiBraceMatcher"/>
        <lang.braceMatcher language="NagiLow" implementationClass="com.disnana.nagi.NagiBraceMatcher$Low"/>
        <lang.foldingBuilder language="Nagi" implementationClass="com.disnana.nagi.NagiFoldingBuilder"/>
        <lang.foldingBuilder language="NagiLow" implementationClass="com.disnana.nagi.NagiFoldingBuilder"/>
        <codeInsight.lineMarkerProvider language="Nagi" implementationClass="com.disnana.nagi.NagiRunLineMarker"/>
        <codeInsight.lineMarkerProvider language="NagiLow" implementationClass="com.disnana.nagi.NagiRunLineMarker"/>
        <applicationConfigurable parentId="language" id="nagi.settings" displayName="Nagi"
                                 instance="com.disnana.nagi.NagiConfigurable"/>
        <applicationService serviceImplementation="com.disnana.nagi.NagiSettings"/>
        <langCodeStyleSettingsProvider implementation="com.disnana.nagi.NagiCodeStyleSettings"/>
        <langCodeStyleSettingsProvider implementation="com.disnana.nagi.NagiCodeStyleSettings$Low"/>
        <enterHandlerDelegate implementation="com.disnana.nagi.NagiEnterHandler"/>
    </extensions>
    <actions>
        <action id="Nagi.Check" class="com.disnana.nagi.NagiCompilerAction$Check" text="Nagi: Check"
                description="Save files and check the nearest Nagi project or selected Nagi file">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Nagi.Run" class="com.disnana.nagi.NagiCompilerAction$Run" text="Nagi: Run"
                description="Save files and run the nearest Nagi project or selected Nagi file">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
