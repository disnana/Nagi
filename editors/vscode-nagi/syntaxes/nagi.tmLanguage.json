{
  "name": "Nagi",
  "scopeName": "source.nagi",
  "patterns": [
    {
      "match": "\\b(def)([\\t ]+)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.nagi"
        },
        "3": {
          "name": "entity.name.function.nagi"
        }
      }
    },
    {
      "match": "\\b(class)([\\t ]+)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.nagi"
        },
        "3": {
          "name": "entity.name.type.nagi"
        }
      }
    },
    {
      "match": "^([\\t ]*)(elif)(?=[\\t ]+.+:[\\t ]*(?:#.*)?$)",
      "captures": {
        "2": {
          "name": "keyword.control.nagi"
        }
      }
    },
    {
      "name": "keyword.control.nagi",
      "match": "\\b(?:def|class)\\b"
    },
    {
      "include": "#common"
    }
  ],
  "repository": {
    "common": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nagi",
          "match": "#.*$"
        },
        {
          "name": "string.quoted.double.nagi",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.nagi",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nagi",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.nagi",
              "match": "\\\\."
            }
          ]
        },
        {
          "match": "\\b(enum)([\\t ]+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.nagi"
            },
            "3": {
              "name": "entity.name.type.enum.nagi"
            }
          }
        },
        {
          "name": "entity.name.function.decorator.nagi",
          "match": "@[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)?"
        },
        {
          "name": "keyword.control.nagi",
          "match": "\\b(?:import|from|as|extern|enum|async|await|return|match|case|if|else|while|for|in|with|scope|spawn|try|and|or|not)\\b"
        },
        {
          "name": "constant.language.nagi",
          "match": "\\b(?:true|false|True|False|Some|None|null|Ok|Err)\\b"
        },
        {
          "name": "support.type.nagi",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|bytes|unit|List|Result|Error|UUID|timestamp|view|shared|Option|Map|fn)\\b"
        },
        {
          "name": "support.function.nagi",
          "match": "\\b(?:print|read_line|write|len|view|copy|share|clone_shared|append|parse_i64|parse_f64|i64|i32|uuid_parse|uuid_format|ok|error|not_found|internal_error|fail|error_kind|error_message|some|env|assert_true|range|include_text|sleep|json_decode|json_encode|slice|size_of|clock_ns|make_ints|bench_i64|bench_f64|bench_scalar|actor_demo|actor_pair_demo|queue_demo|task_demo|cpu_sum|supervisor_demo)\\b(?=\\s*[\\[(])"
        },
        {
          "name": "constant.numeric.nagi",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?\\b"
        },
        {
          "name": "keyword.operator.nagi",
          "match": "->|==|!=|<=|>=|[+*/%=<>?-]"
        }
      ]
    }
  }
}
