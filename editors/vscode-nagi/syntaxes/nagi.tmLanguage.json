{
  "name": "Nagi", "scopeName": "source.nagi",
  "patterns": [
    { "name": "comment.line.number-sign.nagi", "match": "#.*$" },
    { "name": "string.quoted.double.nagi", "begin": "\"", "end": "\"|$", "patterns": [{ "name": "constant.character.escape.nagi", "match": "\\\\." }] },
    { "name": "string.quoted.single.nagi", "begin": "'", "end": "'|$", "patterns": [{ "name": "constant.character.escape.nagi", "match": "\\\\." }] },
    { "name": "entity.name.function.nagi", "match": "(?<=def )\\b[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "entity.name.type.nagi", "match": "(?<=class )\\b[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "entity.name.type.enum.nagi", "match": "(?<=enum )\\b[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "entity.name.function.decorator.nagi", "match": "@[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)?" },
    { "name": "keyword.control.nagi", "match": "\\b(?:import|from|as|extern|def|class|enum|async|await|return|match|case|if|else|while|for|in|with|scope|spawn|try|and|or|not)\\b" },
    { "name": "constant.language.nagi", "match": "\\b(?:true|false|True|False|Some|None|null|Ok|Err)\\b" },
    { "name": "support.type.nagi", "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|bytes|unit|List|Result|Error|Db|Html|UUID|view|shared)\\b" },
    { "name": "support.function.nagi", "match": "\\b(?:print|write|read_line|html|include_text|view|copy|share|clone_shared|len|range|append|ok|some|error|not_found|internal_error|fail|error_kind|error_message|assert_true|parse_i64|parse_f64|env|serve|sleep|db_open|db_exec|db_all|db_query|db_write|db_insert|db_update|json_decode|json_encode|size_of|clock_ns|i32|i64|slice|uuid_parse|uuid_format|actor_demo|actor_pair_demo|queue_demo|task_demo|cpu_sum|supervisor_demo)\\b(?=\\s*[\\[(])" },
    { "name": "constant.numeric.nagi", "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?\\b" },
    { "name": "keyword.operator.nagi", "match": "->|==|!=|<=|>=|[+*/%=<>?-]" }
  ]
}
