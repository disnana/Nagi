{
  "Function": { "prefix": "def", "body": ["def ${1:name}(${2:value: i64}) -> ${3:i64}:", "    ${0:return value}"], "description": "型付き関数" },
  "Class": { "prefix": "class", "body": ["class ${1:Item}:", "    ${2:id}: ${3:i64}", "    ${0:name: str}"], "description": "値型class" },
  "Enum": { "prefix": "enum", "body": ["enum ${1:AuthError}:", "    ${2:InvalidCredentials}", "    ${3:WeakPassword}(${4:message}: ${5:str})", "$0"], "description": "種類ごとに情報を持つenum" },
  "Main": { "prefix": "main", "body": ["def main():", "    print(\"${0:Hello, Nagi!}\")"], "description": "エントリーポイント" },
  "Async main": { "prefix": "amain", "body": ["async def main() -> Result[unit, Error]:", "    await sleep(${1:10})", "    return ok(${0:print(\"Hello, Nagi!\")})"], "description": "DB不要の非同期main" },
  "HTTP server": {"prefix": "httpapp", "body": ["import std.http.server as http", "", "class ${1:State}:", "    greeting: str", "", "async def ${2:hello}(request: http.Request, state: shared[${1}], policy: unit) -> Result[http.Response, Error]:", "    return http.text(http.response_context(view(request)), http.Status.OK, view(state.greeting))", "", "async def main() -> Result[unit, Error]:", "    app = http.app_default[${1}](${1}(greeting=\"${3:Hello, Nagi!}\"))", "    app = try http.route(app, http.Method.GET, \"${4:/}\", http.public_policy[${1}](), ${2})", "    route_policy = try http.rate_policy(1000, 1000)", "    app = try http.rate_route(app, http.Method.GET, \"${4}\", route_policy)", "    limits = http.default_options()", "    limits = try http.authority(limits, \"https://localhost\", [\"localhost:${5:8080}\", \"127.0.0.1:${5}\"], 2, 256)", "    # 明示的な有限予算の例。用途に応じて調整してください。", "    response_budget = try http.response_limits(", "        1048576, 8192, 32, 8192, 32, 65536, 64, 83886080, 1024, 285212672, 8192, 32", "    )", "    limits = try http.with_response_limits(limits, response_budget)", "    rate_budget = try http.rate_limits(64, 64, 4096, 4194304, 65536)", "    limits = try http.with_rate_limits(limits, rate_budget)", "    return await http.serve(app, ${5}, limits)", "$0"], "description": "明示public Policy・Host・有限予算付きHTTPサーバー（新しいファイルに挿入）"},
  "GET handler": {"prefix": "get", "body": ["import std.http.server as http", "", "async def ${1:get_item}(request: http.Request, state: shared[${2:State}], policy: unit) -> Result[http.Response, Error]:", "    return http.text(http.response_context(view(request)), http.Status.OK, view(state.greeting))", "$0"], "description": "明示public_policyと登録するGET callback（greeting: strを持つStateが必要）"},
  "POST handler": {"prefix": "post", "body": ["import std.http.server as http", "", "async def ${1:create_item}(request: http.Request, state: shared[${2:State}], policy: unit) -> Result[http.Response, Error]:", "    return http.text(http.response_context(view(request)), http.Status.CREATED, view(state.greeting))", "$0"], "description": "明示public_policyと登録するPOST callback（認証・CSRF方針は別途設定）"},
  "Loop": { "prefix": "for", "body": ["for ${1:i} in range(${2:10}):", "    ${0:print(i)}"], "description": "整数のループ" },
  "Borrowed array": { "prefix": "vsum", "body": ["def ${1:sum_values}(values: view[i64]) -> i64:", "    total = 0", "    for value in values:", "        total += value", "    return total", "$0"], "description": "配列を借用して集計" },
  "Result match": {"prefix": "match", "body": ["match ${1:result}:", "    case Ok(${2:value}):", "        ${3:print(value)}", "    case Err(${4:problem}):", "        ${0:print(error_kind(problem))}"], "description": "Resultの成功・失敗を分岐"},
  "Nullable match": {"prefix": "match-option", "body": ["match ${1:optional}:", "    case Some(${2:value}):", "        ${3:print(value)}", "    case None:", "        ${0:print(\"missing\")}"], "description": "nullableの値あり・値なしを分岐"}
}
